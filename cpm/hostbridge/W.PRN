

                ;-----------------------------------------------------------------------
                ; W.COM -- copy a file from CP/M out to the HOST.
                ;
                ;       W <cpmfile> [hostfile] [B|T]
                ;       W <pattern>                     e.g.  W *.ASM     W B:*.*
                ;
                ; Part of the altairsim Host Bridge (src/boards/hostbridge.h,
                ; docs/boards/hostbridge.md). Assemble it INSIDE the machine:
                ;
                ;       ASM W                   -> W.HEX
                ;       LOAD W                  -> W.COM
                ;
                ; The name is one letter because it is typed constantly -- see the same
                ; paragraph at the top of R.ASM. W talks to the Host Bridge card at 0B0H
                ; and to nothing else.
                ;
                ;-----------------------------------------------------------------------
                ; EVERY DISK OPERATION IN THIS PROGRAM IS A BDOS CALL, AND THAT IS THE
                ; WHOLE DESIGN. No BIOS entry points, no IN or OUT to a disk controller, no
                ; assumptions about a DPB, a sector size, a skew table or which card the
                ; drive is on. The only ports this program touches are the bridge's own
                ; two. That is what lets the SAME W.COM run against an 88-DCDD 8" disk, an
                ; 88-MDS minidisk and an 8 MB image without being reassembled.
                ;
                ; AND BDOS CLOBBERS EVERY REGISTER (A,B,C,D,E,H,L -- only SP survives).
                ;-----------------------------------------------------------------------
                ; B OR T, AND B IS THE DEFAULT. THAT IS DELIBERATE.
                ;
                ; CP/M stores whole 128-byte records and keeps NO BYTE COUNT anywhere, so a
                ; file's true length is simply not recorded: the last record is padded, by
                ; convention with ^Z. Coming back out to the host, those pad bytes are
                ; indistinguishable from real data -- ONLY THE HUMAN KNOWS whether the file
                ; was text.
                ;
                ;   B (default)  every byte of every record, exactly. A .COM comes out
                ;                byte-for-byte identical, and a text file comes out with up
                ;                to 127 trailing ^Z bytes -- which every editor tolerates.
                ;
                ;   T            stop at the first ^Z. A text file comes out clean, and a
                ;                binary file that happens to contain a 1AH byte comes out
                ;                TRUNCATED, which is why this is not the default.
                ;
                ; WE DO NOT GUESS FROM THE EXTENSION. Keeping a list of names that "are
                ; really binary" (.COM, .REL, .DAT...) only moves the damage to the file
                ; that is not on it: one 1AH and it is silently truncated. Defaulting to
                ; EXACT costs a few pad bytes. Defaulting to text costs your data.
                ;-----------------------------------------------------------------------
                
 0100                   ORG     100H
                
                ;---- CP/M ------------------------------------------------------------
 0005 =         BDOS    EQU     0005H           ; ALWAYS here. Never call the BIOS directly.
 0080 =         TAIL    EQU     0080H           ; the command tail: length, then the text.
                                                ; The CCP has already FOLDED IT TO UPPER
                                                ; CASE -- we cannot see lower case, ever.
 005C =         TFCB    EQU     005CH           ; the FCB the CCP parsed for us. W CAN use
                                                ; this and R cannot, and the reason is the
                                                ; whole difference between the two programs:
                                                ; W's first argument IS an 8.3 CP/M name, so
                                                ; the CCP's 8.3 parse is exactly right for it
                                                ; -- INCLUDING its expansion of `*` into the
                                                ; `?`s that BDOS search wants. R's first
                                                ; argument is a HOST name, which is not 8.3
                                                ; and which that parse would destroy.
                
 0002 =         CONOUT  EQU     2               ; E = char
 0009 =         PRSTR   EQU     9               ; DE = string, '$'-terminated
 000F =         FOPEN   EQU     15
 0014 =         FREAD   EQU     20              ; read sequential
 0011 =         FSRCHF  EQU     17              ; search for first
 0012 =         FSRCHN  EQU     18              ; search for next
 001A =         FSETDMA EQU     26
                
 0080 =         RECLEN  EQU     128             ; a CP/M record. Everything is a multiple.
 0040 =         HNMAX   EQU     64              ; a host name may be a PATH, so it is not 8.3
 0020 =         IDMAX   EQU     32              ; room for the card's signature
 0040 =         MAXN    EQU     64              ; how many wildcard matches we will hold
 001A =         CPMEOF  EQU     1AH             ; ^Z
 000D =         CR      EQU     0DH
 000A =         LF      EQU     0AH
                
                ;---- The Host Bridge (see HB.INC -- ASM.COM has no INCLUDE) -----------
 00B0 =         HBCMD   EQU     0B0H            ; OUT = command   IN = status
 00B1 =         HBDATA  EQU     0B1H            ; data, both ways
                
 0010 =         HERR    EQU     10H             ; the last operation failed
                
 0000 =         CIDENT  EQU     0
 0002 =         CVOPENW EQU     2
 0003 =         CCLOSE  EQU     3
 0007 =         CERROR  EQU     7
 0008 =         CRESET  EQU     8
                
                ;=======================================================================
                ; MAIN
                ;=======================================================================
 0100 31A90E    START:  LXI     SP,STACK
                
                ; RESET first -- ONE byte. This card has no undefined state to climb
                ; out of.
 0103 3E08              MVI     A,CRESET
 0105 D3B0              OUT     HBCMD
                
 0107 CD0503            CALL    IDENT           ; is there even a card there? (exits if not)
 010A CD6703            CALL    PARSE           ; the tail -> CNAME, HNAME, MODE
 010D CD3F02            CALL    INIFCB          ; the CCP's FCB at 5CH -> ours
                
 0110 3AB60A            LDA     CNAME
 0113 B7                ORA     A
 0114 CA3005            JZ      USAGE           ; no arguments at all
                
 0117 CD6202            CALL    HASWLD          ; does the FCB name hold a '?' ...
 011A B7                ORA     A
 011B C22401            JNZ     MANY            ; ...yes: it is a pattern
 011E CD8B01            CALL    ONEF            ; ...no: just the one file
 0121 C30000            JMP     0               ; warm boot
                
                ;=======================================================================
                ; MANY -- a wildcard. Copy every CP/M file that matches.
                ;=======================================================================
                ; WE COLLECT ALL THE NAMES FIRST, AND THEN COPY THEM. That is not the
                ; obvious shape -- R interleaves its enumeration with its transfers -- and
                ; the asymmetry is forced by CP/M, not chosen:
                ;
                ; BDOS SEARCH NEXT (18) HAS NO CURSOR OF ITS OWN. It resumes from state
                ; that BDOS keeps in its ONE shared work area, and ANY other file call --
                ; the OPEN and the READs we are about to do -- overwrites it. Search first,
                ; open, read, search next is a documented way to walk off the end of a
                ; directory into someone else's file. So: take the whole list while nothing
                ; else is touching BDOS, then do the work.
                ;
                ; The HOST bridge has no such problem, which is why R can interleave: its
                ; enumerator is a real cursor that a transfer does not disturb.
                ;
                ; MAXN names is the cap, and hitting it is an ERROR, not a silent stop --
                ; a backup that quietly copied the first 64 of your 200 files would be
                ; worse than one that refused.
                ;=======================================================================
 0124 3A750A    MANY:   LDA     HNAME
 0127 B7                ORA     A
 0128 C23B05            JNZ     EWILD           ; "W *.ASM FOO.TXT" cannot mean anything
                
 012B AF                XRA     A
 012C 32A30B            STA     NCNT
 012F 21A90B            LXI     H,NAMES
 0132 22A50B            SHLD    NPTR            ; where the next match gets stashed
 0135 22A70B            SHLD    CPTR            ; ...and where the copy phase will read from
                
 0138 11CC09            LXI     D,BUF           ; the search results land in the DMA buffer
 013B 0E1A              MVI     C,FSETDMA
 013D CD0500            CALL    BDOS
                
 0140 11510A            LXI     D,FCB
 0143 0E11              MVI     C,FSRCHF
 0145 CD0500            CALL    BDOS
                
 0148 FEFF      MN1:    CPI     0FFH
 014A CA5E01            JZ      MN2             ; 0FFH = no (more) matches
 014D CD7702            CALL    STASH           ; A holds the directory code -- see STASH
 0150 DA5C05            JC      ETOOMNY
 0153 11510A            LXI     D,FCB
 0156 0E12              MVI     C,FSRCHN
 0158 CD0500            CALL    BDOS
 015B C34801            JMP     MN1
                
 015E 3AA30B    MN2:    LDA     NCNT
 0161 B7                ORA     A
 0162 CA5105            JZ      ENOMAT
                
                ; ---- and now the copying, with BDOS's search state safely irrelevant ----
 0165 AF                XRA     A
 0166 32A40B            STA     DONE
                
 0169 3AA40B    MN3:    LDA     DONE
 016C 47                MOV     B,A
 016D 3AA30B            LDA     NCNT
 0170 B8                CMP     B
 0171 CA8801            JZ      EXIT            ; every match done
                
 0174 CDAB02            CALL    SETFCB          ; the next stashed name -> FCB
 0177 AF                XRA     A
 0178 32750A            STA     HNAME           ; a FRESH host name is derived for each file:
                                                ; the previous one is still sitting there
 017B CD8B01            CALL    ONEF            ; (it reports its own failures and carries on)
                
 017E 3AA40B            LDA     DONE
 0181 3C                INR     A
 0182 32A40B            STA     DONE
 0185 C36901            JMP     MN3
                
 0188 C30000    EXIT:   JMP     0               ; warm boot
                
                ;=======================================================================
                ; ONEF -- copy the CP/M file described by FCB out to the host.
                ;
                ; The FCB is already built -- by INIFCB from the command line, or by SETFCB
                ; from a directory entry. HNAME is the host name, or empty to derive one.
                ;=======================================================================
 018B 210000    ONEF:   LXI     H,0
 018E 224C0A            SHLD    RECS
                
                ; A FRESH FCB FOR EVERY OPEN. Extent, the two system bytes, the record
                ; count and the current record must all be zero, and after a wildcard's
                ; second file the FCB we are handed is the one BDOS left behind.
 0191 AF                XRA     A
 0192 325D0A            STA     FCB+12          ; ex
 0195 325E0A            STA     FCB+13          ; s1
 0198 325F0A            STA     FCB+14          ; s2
 019B 32600A            STA     FCB+15          ; rc
 019E 32710A            STA     FCB+32          ; cr -- the sequential record cursor
                
                ; OPEN THE CP/M FILE FIRST, BEFORE TOUCHING THE HOST.
                ;
                ; The order is load-bearing, exactly as it is in R (for the mirror-image
                ; reason). OPEN_WRITE on the card truncates an existing host file, so
                ; creating it first would mean that `W TYPPO.TXT` -- a name that is not on
                ; the disk -- DESTROYS the host file of the same name and leaves an empty
                ; one behind. Fail first, destroy nothing.
 01A1 11510A            LXI     D,FCB
 01A4 0E0F              MVI     C,FOPEN
 01A6 CD0500            CALL    BDOS
 01A9 FEFF              CPI     0FFH
 01AB CA6705            JZ      ENOCPM
                
 01AE AF                XRA     A
 01AF 32710A            STA     FCB+32          ; BDOS OPEN does not promise to clear cr
                
 01B2 3A750A            LDA     HNAME
 01B5 B7                ORA     A
 01B6 C2BC01            JNZ     OF1             ; the user said what to call it
 01B9 CDD302            CALL    FCB2HN          ; ...or we name it after the CP/M file
                OF1:
                
                ;---- Open the host file ----------------------------------------------
 01BC 3E02              MVI     A,CVOPENW
 01BE D3B0              OUT     HBCMD
 01C0 21750A            LXI     H,HNAME
 01C3 CD3903            CALL    SENDZ           ; the NUL is what commits it
                
 01C6 DBB0              IN      HBCMD
 01C8 E610              ANI     HERR
 01CA C2EB01            JNZ     ONEBAD          ; read-only card, outside the sandbox, bad name
                
 01CD CD0C04            CALL    SAYXFR          ; "W: FOO.ASM -> FOO.ASM"
                
 01D0 11CC09            LXI     D,BUF
 01D3 0E1A              MVI     C,FSETDMA
 01D5 CD0500            CALL    BDOS            ; where BDOS puts each record it reads
                
 01D8 CDEF01            CALL    COPY            ; <-- the actual transfer
 01DB D8                RC                      ; carry = it failed and has already said so
                
                ;---- CLOSE IS WHAT COMMITS THE HOST FILE ------------------------------
                ; Not politeness: the card holds the whole file in memory and writes it in
                ; one go here. An unclosed write is DISCARDED -- which is precisely why a
                ; program that dies half way through a transfer cannot leave a truncated
                ; file on your host disk.
 01DC 3E03              MVI     A,CCLOSE
 01DE D3B0              OUT     HBCMD
 01E0 DBB0              IN      HBCMD
 01E2 E610              ANI     HERR
 01E4 C2EB01            JNZ     ONEBAD          ; the host disk is full, or is read-only
                
 01E7 CD2D04            CALL    SAYREC          ; "  3 records"
 01EA C9                RET
                
 01EB CD4203    ONEBAD: CALL    REPERR
 01EE C9                RET
                
                ;-----------------------------------------------------------------------
                ; COPY -- CP/M records -> the host stream. Returns CY on failure.
                ;
                ; NO POLLING LOOP ON TBE, AND THAT IS NOT AN OVERSIGHT. The card is
                ; accumulating the file in host memory, not pushing it down a wire: it can
                ; always take the next byte, and a wait loop would be waiting for something
                ; that has already happened.
                ;-----------------------------------------------------------------------
 01EF 210000    COPY:   LXI     H,0
 01F2 224C0A            SHLD    RECS
 01F5 224E0A            SHLD    BYTES           ; the TRUE byte count too -- 24 bits, because in T
 01F8 AF                XRA     A               ; mode we stop mid-record and RECS*128 would lie
 01F9 32500A            STA     BYTES+2
                
 01FC 11510A    CP0:    LXI     D,FCB
 01FF 0E14              MVI     C,FREAD
 0201 CD0500            CALL    BDOS
 0204 B7                ORA     A
 0205 C23802            JNZ     CPEND           ; 1 = end of file. Anything else is also an
                                                ; end, and there is nothing useful to say
                                                ; about it that CP/M has not already said.
                
 0208 2A4C0A            LHLD    RECS            ; count it now: in text mode we may stop half
 020B 23                INX     H               ; way through this record, and it was still
 020C 224C0A            SHLD    RECS            ; read
                
 020F 21CC09            LXI     H,BUF
 0212 0680              MVI     B,RECLEN
                
 0214 7E        CP1:    MOV     A,M
 0215 4F                MOV     C,A             ; stash the byte -- LDA is about to eat A
 0216 3A8605            LDA     MODE
 0219 FE54              CPI     'T'
 021B 79                MOV     A,C             ; ...and give it back
 021C C22402            JNZ     CP2             ; binary: send everything, always
 021F FE1A              CPI     CPMEOF
 0221 CA3802            JZ      CPEND           ; text: the FIRST ^Z ends the file
                
 0224 D3B1      CP2:    OUT     HBDATA
 0226 CD4604            CALL    INCBYT          ; one more byte actually sent to the host -- count it
 0229 23                INX     H
 022A 05                DCR     B
 022B C21402            JNZ     CP1
                
                ; ASK ONCE PER RECORD, NOT ONCE PER BYTE. The only way a write can fail
                ; while it is still streaming is the card's 8 MB size cap, and a CP/M
                ; volume cannot be pushed past that in less than 65,536 records. Checking
                ; here costs one IN per 128 bytes and catches it long before we have
                ; shovelled a whole disk into a buffer that is never going to be written.
 022E DBB0              IN      HBCMD
 0230 E610              ANI     HERR
 0232 C23A02            JNZ     CPERR
 0235 C3FC01            JMP     CP0
                
 0238 AF        CPEND:  XRA     A               ; ...which also CLEARS CARRY: success
 0239 C9                RET
                
 023A CD4203    CPERR:  CALL    REPERR
 023D 37                STC
 023E C9                RET
                
                ;=======================================================================
                ; THE CP/M DIRECTORY
                ;=======================================================================
                
                ;-----------------------------------------------------------------------
                ; INIFCB -- the CCP's parsed FCB at 005CH -> our own FCB.
                ;
                ; We copy it rather than use it in place. The CCP put a SECOND FCB at
                ; 006CH, twelve bytes in, and the moment BDOS opens the first one it writes
                ; an extent and a record count straight through the second. Copying is one
                ; loop and it makes the overlap somebody else's problem.
                ;
                ; Bytes 0..11 are all we want: the drive, and the eleven characters of the
                ; 8.3 name -- with `*` already expanded to `?` by the CCP, which is exactly
                ; the form BDOS SEARCH wants. The rest of the FCB must start at zero.
                ;-----------------------------------------------------------------------
 023F 21510A    INIFCB: LXI     H,FCB
 0242 0624              MVI     B,36
 0244 3600      IF0:    MVI     M,0
 0246 23                INX     H
 0247 05                DCR     B
 0248 C24402            JNZ     IF0
                
 024B 215C00            LXI     H,TFCB
 024E 11510A            LXI     D,FCB
 0251 060C              MVI     B,12
 0253 7E        IF1:    MOV     A,M
 0254 12                STAX    D
 0255 23                INX     H
 0256 13                INX     D
 0257 05                DCR     B
 0258 C25302            JNZ     IF1
                
 025B 3A510A            LDA     FCB             ; remember the drive: a wildcard rebuilds the
 025E 328705            STA     DRIVE           ; FCB for each match and must put it back
 0261 C9                RET
                
                ;-----------------------------------------------------------------------
                ; HASWLD -- A=1 if the FCB name holds a '?', else A=0.
                ;
                ; We look at the FCB, not at the text, because the CCP has already done the
                ; expansion: it turned `*.ASM` into `????????ASM` before we ever ran. So
                ; `?` is the only wildcard character that still exists by the time we look.
                ;-----------------------------------------------------------------------
 0262 21520A    HASWLD: LXI     H,FCB+1
 0265 060B              MVI     B,11
 0267 7E        HW1:    MOV     A,M
 0268 FE3F              CPI     '?'
 026A CA7402            JZ      HWYES
 026D 23                INX     H
 026E 05                DCR     B
 026F C26702            JNZ     HW1
 0272 AF                XRA     A
 0273 C9                RET
 0274 3E01      HWYES:  MVI     A,1
 0276 C9                RET
                
                ;-----------------------------------------------------------------------
                ; STASH -- copy the name of the directory entry BDOS just found.
                ;
                ; BDOS SEARCH returns 0..3 in A: the entry is at BUF + A*32. (It hands back
                ; the whole 128-byte sector and tells you which of the four 32-byte entries
                ; in it was the hit. It does not hand you the entry.)
                ;
                ; Returns CY if the table is full.
                ;-----------------------------------------------------------------------
 0277 4F        STASH:  MOV     C,A             ; the directory code, before anything eats it
                
 0278 3AA30B            LDA     NCNT
 027B FE40              CPI     MAXN
 027D D2A902            JNC     STFULL
 0280 3C                INR     A
 0281 32A30B            STA     NCNT
                
 0284 79                MOV     A,C
 0285 E603              ANI     3               ; belt and braces: it is documented as 0..3
 0287 87                ADD     A               ; *2
 0288 87                ADD     A               ; *4
 0289 87                ADD     A               ; *8
 028A 87                ADD     A               ; *16
 028B 87                ADD     A               ; *32 -- at most 96, so it stays in 8 bits
 028C 5F                MOV     E,A
 028D 1600              MVI     D,0
 028F 21CC09            LXI     H,BUF
 0292 19                DAD     D
 0293 23                INX     H               ; -> the eleven name characters (past the
                                                ; user-number byte at offset 0)
 0294 EB                XCHG                    ; DE = source
 0295 2AA50B            LHLD    NPTR            ; HL = where it goes
 0298 060B              MVI     B,11
 029A 1A        ST1:    LDAX    D
 029B E67F              ANI     7FH             ; STRIP THE ATTRIBUTE BITS. CP/M keeps R/O,
                                                ; SYSTEM and ARCHIVE in the HIGH BIT of three
                                                ; of the name characters, so a read-only
                                                ; FOO.COM has an 0C3H where its 'M' should be.
                                                ; Hand that to OPEN unmasked and it does not
                                                ; find the file it just told you about.
 029D 77                MOV     M,A
 029E 13                INX     D
 029F 23                INX     H
 02A0 05                DCR     B
 02A1 C29A02            JNZ     ST1
 02A4 22A50B            SHLD    NPTR
 02A7 B7                ORA     A               ; ORA also CLEARS CARRY -- that is the point
 02A8 C9                RET
                
 02A9 37        STFULL: STC
 02AA C9                RET
                
                ;-----------------------------------------------------------------------
                ; SETFCB -- the next stashed name -> FCB, and advance the cursor.
                ;-----------------------------------------------------------------------
 02AB 21510A    SETFCB: LXI     H,FCB
 02AE 0624              MVI     B,36
 02B0 3600      SF0:    MVI     M,0
 02B2 23                INX     H
 02B3 05                DCR     B
 02B4 C2B002            JNZ     SF0
                
 02B7 3A8705            LDA     DRIVE           ; the drive the user asked for. The directory
 02BA 32510A            STA     FCB             ; entry does not carry one -- it is a fact
                                                ; about the disk it was found on, and the
                                                ; entry has a USER NUMBER in that byte instead
                
 02BD 2AA70B            LHLD    CPTR
 02C0 EB                XCHG                    ; DE = the stashed name
 02C1 21520A            LXI     H,FCB+1
 02C4 060B              MVI     B,11
 02C6 1A        SF1:    LDAX    D
 02C7 77                MOV     M,A
 02C8 13                INX     D
 02C9 23                INX     H
 02CA 05                DCR     B
 02CB C2C602            JNZ     SF1
 02CE EB                XCHG                    ; HL = one past the name...
 02CF 22A70B            SHLD    CPTR            ; ...which is the next one
 02D2 C9                RET
                
                ;-----------------------------------------------------------------------
                ; FCB2HN -- name the host file after the CP/M one: FOO.ASM -> "FOO.ASM".
                ;
                ; The FCB pads both fields with SPACES, and no CP/M name may contain one,
                ; so a blank simply ends the field.
                ;-----------------------------------------------------------------------
 02D3 21520A    FCB2HN: LXI     H,FCB+1
 02D6 11750A            LXI     D,HNAME
 02D9 0608              MVI     B,8
 02DB CDF702            CALL    FLD
                
 02DE 3A5A0A            LDA     FCB+9
 02E1 E67F              ANI     7FH             ; an attribute bit, not a letter -- see FLD
 02E3 FE20              CPI     ' '
 02E5 CAF402            JZ      F2Z             ; no extension: no dot either
 02E8 3E2E              MVI     A,'.'
 02EA 12                STAX    D
 02EB 13                INX     D
 02EC 215A0A            LXI     H,FCB+9
 02EF 0603              MVI     B,3
 02F1 CDF702            CALL    FLD
                
 02F4 AF        F2Z:    XRA     A
 02F5 12                STAX    D               ; NUL-terminated: that is what SENDZ wants
 02F6 C9                RET
                
                ; Copy up to B characters from (HL) to (DE), stopping at the first blank.
                ;
                ; STRIP THE ATTRIBUTE BITS HERE TOO. STASH cleaned the name it put in the
                ; FCB, but this runs AFTER the OPEN -- and CP/M 3's OPEN writes the file's
                ; R/O, SYSTEM and ARCHIVE bits back into the high bit of the FCB's name
                ; characters. A read-only HELP.COM came back as HELP.0C3H'OM', which is
                ; no name a host will create.
 02F7 7E        FLD:    MOV     A,M
 02F8 E67F              ANI     7FH
 02FA FE20              CPI     ' '
 02FC C8                RZ
 02FD 12                STAX    D
 02FE 13                INX     D
 02FF 23                INX     H
 0300 05                DCR     B
 0301 C2F702            JNZ     FLD
 0304 C9                RET
                
                ;=======================================================================
                ; THE HOST BRIDGE
                ;=======================================================================
                
                ;-----------------------------------------------------------------------
                ; IDENT -- prove there is a card there before we do anything else.
                ;
                ; THIS IS NOT CEREMONY. An IN from a port that no card decodes FLOATS THE
                ; BUS and the 8080 reads 0FFH. W's failure mode without this is quieter
                ; than R's and nastier: every OUT would go into the void, every status read
                ; would come back 0FFH -- which has HERR set -- and the program would
                ; announce a host error for a card that is not there. "Permission denied"
                ; is a much worse thing to tell someone than "there is no bridge".
                ;-----------------------------------------------------------------------
 0305 3E00      IDENT:  MVI     A,CIDENT
 0307 D3B0              OUT     HBCMD
                
 0309 21790B            LXI     H,IDBUF
 030C 0620              MVI     B,IDMAX
 030E DBB1      ID1:    IN      HBDATA
 0310 77                MOV     M,A
 0311 B7                ORA     A
 0312 CA1C03            JZ      ID2             ; got the terminator
 0315 23                INX     H
 0316 05                DCR     B
 0317 C20E03            JNZ     ID1
 031A 3600              MVI     M,0             ; never terminated -- 0FFH forever, i.e. no card
                
 031C 21790B    ID2:    LXI     H,IDBUF
 031F 117105            LXI     D,IDWANT
 0322 1A        ID3:    LDAX    D
 0323 B7                ORA     A
 0324 C8                RZ                      ; matched to the end of what we wanted: ours.
                                                ; A PREFIX compare, so a later card that says
                                                ; "... 2" still works with this .COM
 0325 BE                CMP     M
 0326 C22E03            JNZ     IDBAD
 0329 23                INX     H
 032A 13                INX     D
 032B C32203            JMP     ID3
                
 032E 118805    IDBAD:  LXI     D,MNOHB
 0331 0E09              MVI     C,PRSTR
 0333 CD0500            CALL    BDOS
 0336 C30000            JMP     0               ; nothing else in this program can work
                
                ;-----------------------------------------------------------------------
                ; SENDZ -- send the NUL-terminated string at HL to the data port.
                ;
                ; The NUL goes too, AND IT IS THE NUL THAT COMMITS THE COMMAND. Until it
                ; lands the card has created nothing, so we could still change our mind by
                ; writing a different command byte.
                ;-----------------------------------------------------------------------
 0339 7E        SENDZ:  MOV     A,M
 033A D3B1              OUT     HBDATA
 033C B7                ORA     A
 033D C8                RZ                      ; that was the terminator: done
 033E 23                INX     H
 033F C33903            JMP     SENDZ
                
                ;-----------------------------------------------------------------------
                ; REPERR -- print what actually went wrong.
                ;
                ; The card hands back a code byte and then a MESSAGE in the host's own
                ; words ("FOO.TXT: permission denied"). We print the message and drop the
                ; code: a number the user has to go and look up is not an error report.
                ;-----------------------------------------------------------------------
 0342 3E07      REPERR: MVI     A,CERROR
 0344 D3B0              OUT     HBCMD
 0346 DBB1              IN      HBDATA          ; the code byte -- read it and discard it
                
 0348 116C08            LXI     D,MERR
 034B 0E09              MVI     C,PRSTR
 034D CD0500            CALL    BDOS
                
 0350 DBB1      RPE1:   IN      HBDATA          ; ...then the text, a character at a time.
 0352 B7                ORA     A               ; Nothing is live across the BDOS call below,
 0353 CA5F03            JZ      RPE2            ; because the next byte comes from the PORT.
 0356 5F                MOV     E,A
 0357 0E02              MVI     C,CONOUT
 0359 CD0500            CALL    BDOS
 035C C35003            JMP     RPE1
                
 035F 117008    RPE2:   LXI     D,MCRLF
 0362 0E09              MVI     C,PRSTR
 0364 C30500            JMP     BDOS            ; tail call: BDOS returns to OUR caller
                
                ;=======================================================================
                ; THE COMMAND TAIL
                ;=======================================================================
                
                ;-----------------------------------------------------------------------
                ; PARSE -- pull up to three words out of the command tail at 0080H.
                ;
                ;       W FOO.TXT                 CNAME=FOO.TXT
                ;       W FOO.TXT T               CNAME=FOO.TXT              MODE=T
                ;       W FOO.TXT BAR.TXT         CNAME=FOO.TXT HNAME=BAR.TXT
                ;       W FOO.TXT SRC/BAR.TXT T   ...and a subdirectory of hostdir
                ;
                ; A LONE `B` OR `T` IN THE SECOND SLOT IS THE SWITCH, NOT A HOST NAME, and
                ; that is an ambiguity we are choosing rather than one we are missing: a
                ; host file really called `T` exists somewhere. Write it as `./T` and the
                ; card drops the `.` component -- so the escape hatch costs two characters
                ; and no one has to learn a new syntax.
                ;
                ; The FCB comes from the CCP (see TFCB), so CNAME here is only ever used to
                ; answer "did the user type anything at all".
                ;-----------------------------------------------------------------------
                ; EMPTY THE HOST NAME BEFORE WE START, and this is not belt and braces.
                ; HNAME is a DS, so it is not in the .COM file at all -- LOAD stops writing
                ; at the last DB, and what is at that address when we run is whatever the
                ; PREVIOUS program left there. Every other buffer here is filled by TOKEN,
                ; which always writes its NUL; HNAME is the one that is only written when
                ; the user gave a second word. Leave it and `W *.HEX` reads the corpse of
                ; the last program's data as a host name and refuses the wildcard.
 0367 AF        PARSE:  XRA     A
 0368 32750A            STA     HNAME
                
 036B 218000            LXI     H,TAIL
 036E 46                MOV     B,M             ; length of the tail
 036F 23                INX     H               ; -> the first character
                
 0370 CDE403            CALL    SKIPSP
 0373 11B60A            LXI     D,CNAME
 0376 0E40              MVI     C,HNMAX
 0378 CDF003            CALL    TOKEN
                
 037B CDE403            CALL    SKIPSP
 037E 11F70A            LXI     D,TOK2
 0381 0E40              MVI     C,HNMAX
 0383 CDF003            CALL    TOKEN
                
 0386 CDE403            CALL    SKIPSP
 0389 11380B            LXI     D,TOK3
 038C 0E40              MVI     C,HNMAX
 038E CDF003            CALL    TOKEN
                
 0391 3A380B            LDA     TOK3
 0394 B7                ORA     A
 0395 CAA403            JZ      PA2             ; only two words (or fewer)
                
                ; Three words: the second is the host name and the third is the switch.
 0398 21F70A            LXI     H,TOK2
 039B CDD803            CALL    CPYHN
 039E 21380B            LXI     H,TOK3
 03A1 C3C903            JMP     SETMOD
                
 03A4 3AF70A    PA2:    LDA     TOK2
 03A7 B7                ORA     A
 03A8 C8                RZ                      ; one word: nothing more to work out
                
 03A9 3AF80A            LDA     TOK2+1
 03AC B7                ORA     A
 03AD C2C303            JNZ     PA3             ; longer than one character -> a host name
 03B0 3AF70A            LDA     TOK2
 03B3 FE42              CPI     'B'
 03B5 CABD03            JZ      PA2S
 03B8 FE54              CPI     'T'
 03BA C2C303            JNZ     PA3
 03BD 21F70A    PA2S:   LXI     H,TOK2
 03C0 C3C903            JMP     SETMOD
                
 03C3 21F70A    PA3:    LXI     H,TOK2
 03C6 C3D803            JMP     CPYHN           ; tail call
                
 03C9 7E        SETMOD: MOV     A,M
 03CA FE42              CPI     'B'
 03CC CAD403            JZ      SM1
 03CF FE54              CPI     'T'
 03D1 C24605            JNZ     EBADSW
 03D4 328605    SM1:    STA     MODE
 03D7 C9                RET
                
 03D8 11750A    CPYHN:  LXI     D,HNAME
 03DB 7E        CH1:    MOV     A,M
 03DC 12                STAX    D
 03DD B7                ORA     A
 03DE C8                RZ                      ; the NUL is copied too
 03DF 23                INX     H
 03E0 13                INX     D
 03E1 C3DB03            JMP     CH1
                
 03E4 78        SKIPSP: MOV     A,B
 03E5 B7                ORA     A
 03E6 C8                RZ                      ; nothing left
 03E7 7E                MOV     A,M
 03E8 FE20              CPI     ' '
 03EA C0                RNZ
 03EB 23                INX     H
 03EC 05                DCR     B
 03ED C3E403            JMP     SKIPSP
                
                ; Copy one space-delimited word from (HL) to (DE), NUL-terminated.
                ;   B = characters left in the tail   C = room at DE, including the NUL
                ; Always writes the NUL -- so "no word here" comes out as an empty string,
                ; which is exactly what the callers test for.
 03F0 79        TOKEN:  MOV     A,C
 03F1 FE01              CPI     1
 03F3 CA0904            JZ      TOKEND          ; only room for the terminator
 03F6 78                MOV     A,B
 03F7 B7                ORA     A
 03F8 CA0904            JZ      TOKEND
 03FB 7E                MOV     A,M
 03FC FE20              CPI     ' '
 03FE CA0904            JZ      TOKEND
 0401 12                STAX    D
 0402 23                INX     H
 0403 13                INX     D
 0404 05                DCR     B
 0405 0D                DCR     C
 0406 C3F003            JMP     TOKEN
 0409 AF        TOKEND: XRA     A
 040A 12                STAX    D
 040B C9                RET
                
                ;=======================================================================
                ; TALKING TO THE USER
                ;=======================================================================
                
                ; "W: FOO.ASM -> SRC/FOO.ASM"
 040C 114F08    SAYXFR: LXI     D,MPFX
 040F 0E09              MVI     C,PRSTR
 0411 CD0500            CALL    BDOS
 0414 CDB304            CALL    PRFCB
 0417 115308            LXI     D,MARROW
 041A 0E09              MVI     C,PRSTR
 041C CD0500            CALL    BDOS
 041F 21750A            LXI     H,HNAME
 0422 CDA404            CALL    PSTR
 0425 117008            LXI     D,MCRLF
 0428 0E09              MVI     C,PRSTR
 042A C30500            JMP     BDOS
                
                ; "  12 records, 1493 bytes"
 042D 2A4C0A    SAYREC: LHLD    RECS
 0430 CDF904            CALL    PRDEC
 0433 115808            LXI     D,MRECS         ; " records, "
 0436 0E09              MVI     C,PRSTR
 0438 CD0500            CALL    BDOS
 043B CD5704            CALL    PRBYT           ; the exact number of bytes we sent to the host
 043E 116308            LXI     D,MBYTES        ; " bytes",CR,LF
 0441 0E09              MVI     C,PRSTR
 0443 C30500            JMP     BDOS
                
                ;-----------------------------------------------------------------------
                ; INCBYT -- add one to the 24-bit counter at BYTES. Touches only HL (saved
                ; and restored) and the flags, so A, B and C survive the copy loop.
                ;-----------------------------------------------------------------------
 0446 E5        INCBYT: PUSH    H
 0447 214E0A            LXI     H,BYTES
 044A 34                INR     M
 044B C25504            JNZ     IB1             ; no carry out of the low byte -- done
 044E 23                INX     H
 044F 34                INR     M
 0450 C25504            JNZ     IB1
 0453 23                INX     H
 0454 34                INR     M
 0455 E1        IB1:    POP     H
 0456 C9                RET
                
                ;-----------------------------------------------------------------------
                ; PRBYT -- print the 24-bit value at BYTES in decimal, the same backwards-
                ; into-the-buffer way PRDEC prints HL. Divides BYTES by ten in place.
                ;-----------------------------------------------------------------------
 0457 11A20B    PRBYT:  LXI     D,NUMEND
 045A 3E24              MVI     A,'$'
 045C 12                STAX    D
 045D 1B        PRB1:   DCX     D
 045E D5                PUSH    D               ; DIV10T eats DE
 045F CD7704            CALL    DIV10T          ; BYTES = BYTES/10, A = the remainder
 0462 D1                POP     D
 0463 C630              ADI     '0'
 0465 12                STAX    D
 0466 3A4E0A            LDA     BYTES           ; anything left?
 0469 214F0A            LXI     H,BYTES+1
 046C B6                ORA     M
 046D 23                INX     H
 046E B6                ORA     M
 046F C25D04            JNZ     PRB1
 0472 0E09              MVI     C,PRSTR
 0474 C30500            JMP     BDOS
                
                ; DIV10T -- BYTES (24-bit) = BYTES/10, remainder returned in A. Long
                ; division from the top byte down: a running remainder r<10 makes
                ; r*256+byte < 2560, which fits in DE, so each byte is one small divide.
 0477 AF        DIV10T: XRA     A               ; the running remainder starts at 0
 0478 21500A            LXI     H,BYTES+2       ; most significant byte first
 047B CD8604            CALL    DT1
 047E 2B                DCX     H
 047F CD8604            CALL    DT1
 0482 2B                DCX     H
 0483 C38604            JMP     DT1             ; tail: A = the final remainder
                
                ; DT1 -- acc = A*256 + (HL); (HL) = acc/10; A = acc MOD 10.  HL is left
                ; where it was, so DIV10T just steps it down a byte between calls.
 0486 57        DT1:    MOV     D,A             ; DE = acc, D the high byte (< 10)
 0487 5E                MOV     E,M
 0488 0600              MVI     B,0             ; the quotient byte
 048A 7A        DT2:    MOV     A,D
 048B B7                ORA     A
 048C C29504            JNZ     DT3             ; high byte set -> acc >= 256, so >= 10
 048F 7B                MOV     A,E
 0490 FE0A              CPI     10
 0492 DAA104            JC      DT4             ; acc < 10 -> E is the remainder
 0495 7B        DT3:    MOV     A,E
 0496 D60A              SUI     10
 0498 5F                MOV     E,A
 0499 7A                MOV     A,D
 049A DE00              SBI     0
 049C 57                MOV     D,A
 049D 04                INR     B
 049E C38A04            JMP     DT2
 04A1 70        DT4:    MOV     M,B             ; store the quotient byte back in place
 04A2 7B                MOV     A,E             ; the remainder feeds the next byte down
 04A3 C9                RET
                
                ; PSTR -- print the NUL-terminated string at HL.
                ; HL is pushed around the BDOS call because BDOS EATS EVERY REGISTER.
 04A4 7E        PSTR:   MOV     A,M
 04A5 B7                ORA     A
 04A6 C8                RZ
 04A7 E5                PUSH    H
 04A8 5F                MOV     E,A
 04A9 0E02              MVI     C,CONOUT
 04AB CD0500            CALL    BDOS
 04AE E1                POP     H
 04AF 23                INX     H
 04B0 C3A404            JMP     PSTR
                
                ; PRFCB -- print the FCB as "d:NAME.EXT".
 04B3 3A510A    PRFCB:  LDA     FCB
 04B6 B7                ORA     A
 04B7 CAC404            JZ      PF1             ; drive 0 = "the current one"; do not print it
 04BA C640              ADI     'A'-1
 04BC CDF304            CALL    PUTCH
 04BF 3E3A              MVI     A,':'
 04C1 CDF304            CALL    PUTCH
 04C4 21520A    PF1:    LXI     H,FCB+1
 04C7 0608              MVI     B,8
 04C9 CDDE04            CALL    PFLD
 04CC 3A5A0A            LDA     FCB+9
 04CF E67F              ANI     7FH             ; an attribute bit, not a letter -- see FLD
 04D1 FE20              CPI     ' '
 04D3 C8                RZ                      ; no extension: nothing to print
 04D4 3E2E              MVI     A,'.'
 04D6 CDF304            CALL    PUTCH
 04D9 215A0A            LXI     H,FCB+9
 04DC 0603              MVI     B,3
 04DE 7E        PFLD:   MOV     A,M             ; print B characters at HL, skipping the
 04DF E67F              ANI     7FH             ; (no attribute bits -- see FLD)
 04E1 FE20              CPI     ' '             ; blanks an FCB pads with
 04E3 CAED04            JZ      PFL2
 04E6 C5                PUSH    B
 04E7 E5                PUSH    H
 04E8 CDF304            CALL    PUTCH
 04EB E1                POP     H
 04EC C1                POP     B
 04ED 23        PFL2:   INX     H
 04EE 05                DCR     B
 04EF C2DE04            JNZ     PFLD
 04F2 C9                RET
                
 04F3 5F        PUTCH:  MOV     E,A
 04F4 0E02              MVI     C,CONOUT
 04F6 C30500            JMP     BDOS
                
                ;-----------------------------------------------------------------------
                ; PRDEC -- print HL in decimal.
                ;
                ; Built backwards from the end of a buffer, so no digit reversal is needed,
                ; and terminated with '$' so BDOS 9 prints the whole thing in one call.
                ;-----------------------------------------------------------------------
 04F9 11A20B    PRDEC:  LXI     D,NUMEND
 04FC 3E24              MVI     A,'$'
 04FE 12                STAX    D
 04FF 1B        PD1:    DCX     D
 0500 CD1005            CALL    DIV10           ; HL = HL/10, A = the remainder
 0503 C630              ADI     '0'
 0505 12                STAX    D
 0506 7C                MOV     A,H
 0507 B5                ORA     L
 0508 C2FF04            JNZ     PD1             ; ...until nothing is left
 050B 0E09              MVI     C,PRSTR
 050D C30500            JMP     BDOS            ; DE already points at the first digit
                
                ; DIV10 -- HL = HL/10, A = the remainder. The 8080 has no divide, so this
                ; is repeated subtraction. A record count is small and this is not a hot
                ; loop.
 0510 C5        DIV10:  PUSH    B
 0511 010000            LXI     B,0
 0514 7C        DV1:    MOV     A,H
 0515 B7                ORA     A
 0516 C21F05            JNZ     DV2             ; H nonzero -> definitely >= 10
 0519 7D                MOV     A,L
 051A FE0A              CPI     10
 051C DA2B05            JC      DV3             ; < 10: what is left is the remainder
 051F 7D        DV2:    MOV     A,L
 0520 D60A              SUI     10
 0522 6F                MOV     L,A
 0523 7C                MOV     A,H
 0524 DE00              SBI     0
 0526 67                MOV     H,A
 0527 03                INX     B
 0528 C31405            JMP     DV1
 052B 7D        DV3:    MOV     A,L             ; the remainder -- grab it BEFORE clobbering L
 052C 60                MOV     H,B
 052D 69                MOV     L,C             ; HL = the quotient
 052E C1                POP     B
 052F C9                RET
                
                ;=======================================================================
                ; ERRORS
                ;=======================================================================
                ; THE ONES BELOW THAT WARM-BOOT ARE REACHED FROM `START` OR `MANY`, WHICH
                ; ARE JUMP TARGETS AND NOT SUBROUTINES. The stack is empty there, so a RET
                ; would pop garbage and execute it. ENOCPM is the only one reached from
                ; inside ONEF -- which WAS called -- so it is the only one that may return.
 0530 11EE05    USAGE:  LXI     D,MUSAGE
 0533 0E09              MVI     C,PRSTR
 0535 CD0500            CALL    BDOS
 0538 C30000            JMP     0
                
 053B 117308    EWILD:  LXI     D,MEWILD
 053E 0E09              MVI     C,PRSTR
 0540 CD0500            CALL    BDOS
 0543 C30000            JMP     0
                
 0546 11DE08    EBADSW: LXI     D,MEBADSW
 0549 0E09              MVI     C,PRSTR
 054B CD0500            CALL    BDOS
 054E C30000            JMP     0
                
 0551 112A09    ENOMAT: LXI     D,MENOMAT
 0554 0E09              MVI     C,PRSTR
 0556 CD0500            CALL    BDOS
 0559 C30000            JMP     0
                
 055C 114509    ETOOMNY:LXI     D,METOOM
 055F 0E09              MVI     C,PRSTR
 0561 CD0500            CALL    BDOS
 0564 C30000            JMP     0
                
                ; Print the message, return with CARRY SET so a wildcard walk can go on to
                ; the next file instead of giving up on all of them.
 0567 11B409    ENOCPM: LXI     D,MENOCPM
 056A 0E09              MVI     C,PRSTR
 056C CD0500            CALL    BDOS
 056F 37                STC
 0570 C9                RET
                
                ;=======================================================================
                ; DATA
                ;=======================================================================
 0571 414C544149IDWANT: DB      'ALTAIRSIM HOSTBRIDGE',0
                
 0586 42        MODE:   DB      'B'             ; B = every byte, exactly. See the top.
 0587 00        DRIVE:  DB      0
                
 0588 0D0A573A20MNOHB:  DB      CR,LF,'W: no host bridge at B0H.',CR,LF
 05A5 5468697320        DB      'This machine has no `hostbridge` card in it, or it is at'
 05DD 20616E6F74        DB      ' another port.',CR,LF,'$'
                
 05EE 0D0A57202DMUSAGE: DB      CR,LF,'W -- copy a file from CP/M out to the host.  (1.1)',CR,LF,CR,LF
 0626 2020205720        DB      '   W <cpmfile> [hostfile] [B|T]',CR,LF
 0647 2020205720        DB      '   W <pattern>',CR,LF,CR,LF
 0659 4578616D70        DB      'Examples',CR,LF
 0663 2020205720        DB      '   W FOO.ASM            CP/M FOO.ASM -> host FOO.ASM',CR,LF
 0699 2020205720        DB      '   W FOO.ASM SRC/F.ASM  ...into a subdirectory of hostdir',CR,LF
 06D4 2020205720        DB      '   W FOO.ASM T          stop at the first ^Z -- for TEXT',CR,LF
 070E 2020205720        DB      '   W *.ASM              every match, each under its own name'
 074A 0D0A0D0A          DB      CR,LF,CR,LF
 074E 4220287468        DB      'B (the default) copies every byte of every record, so a .COM'
 078A 2073757276        DB      ' survives',CR,LF
 0795 7468652074        DB      'the trip and a text file arrives padded with ^Z. T stops at'
 07D0 2074686520        DB      ' the first',CR,LF
 07DC 5E5A2C2077        DB      '^Z, which cleans up text and TRUNCATES anything binary.'
 0813 0D0A              DB      CR,LF
 0815 4844495220        DB      'HDIR lists what is on the host. R copies the other way.'
 084C 0D0A24            DB      CR,LF,'$'
                
 084F 573A2024  MPFX:   DB      'W: $'
 0853 202D3E2024MARROW: DB      ' -> $'
 0858 207265636FMRECS:  DB      ' records, $'
 0863 2062797465MBYTES: DB      ' bytes',CR,LF,'$'
 086C 573A2024  MERR:   DB      'W: $'
 0870 0D0A24    MCRLF:  DB      CR,LF,'$'
                
 0873 573A206120MEWILD: DB      'W: a wildcard copies each file under its own name -- so a'
 08AC 207365636F        DB      ' second name',CR,LF,'   cannot mean anything. Drop it.'
 08DB 0D0A24            DB      CR,LF,'$'
 08DE 573A207468MEBADSW:DB      'W: the switch is B (every byte, the default) or T (stop at'
 0918 2074686520        DB      ' the first ^Z).',CR,LF,'$'
 092A 573A206E6FMENOMAT:DB      'W: no CP/M file matches.',CR,LF,'$'
 0945 573A206D6FMETOOM: DB      'W: more than 64 files match. Narrow the pattern.',CR,LF
 0977 2020204E6F        DB      '   Nothing was copied -- half a backup is worse than none.'
 09B1 0D0A24            DB      CR,LF,'$'
 09B4 573A206E6FMENOCPM:DB      'W: no such CP/M file.',CR,LF,'$'
                
                ;---- Variables -------------------------------------------------------
                ; THE DMA BUFFER -- one CP/M record. BDOS reads each record INTO here (we
                ; point it at this with FSETDMA), and COPY hands it to the card a byte at a
                ; time. BDOS SEARCH also uses it, for the directory sector it found.
 09CC           BUF:    DS      RECLEN
                
 0A4C           RECS:   DS      2               ; records read from CP/M
 0A4E           BYTES:  DS      3               ; and the true byte count, 24 bits: even the card's
                                                ; 8 MB ceiling needs more than RECS's 16
 0A51           FCB:    DS      36              ; ours, copied out of the CCP's -- see INIFCB
 0A75           HNAME:  DS      HNMAX+1         ; the host name (given, or derived)
 0AB6           CNAME:  DS      HNMAX+1         ; the first word of the tail, as typed
 0AF7           TOK2:   DS      HNMAX+1
 0B38           TOK3:   DS      HNMAX+1
 0B79           IDBUF:  DS      IDMAX+1         ; what the card said its name was
 0B9A           NUMBUF: DS      8               ; wide enough for a 24-bit count: 16777215 is 8 digits
 0BA2           NUMEND: DS      1               ; PRDEC and PRBYT build backwards from here
                
 0BA3           NCNT:   DS      1               ; how many wildcard matches we found
 0BA4           DONE:   DS      1               ; how many of them we have copied
 0BA5           NPTR:   DS      2               ; the collect cursor into NAMES
 0BA7           CPTR:   DS      2               ; the copy cursor into NAMES
 0BA9           NAMES:  DS      MAXN*11         ; eleven characters each, no dot, no drive
                
 0E69                   DS      64              ; stack: BDOS is the deepest thing we call
 0EA9 =         STACK   EQU     $
                
 0EA9                   END     START
