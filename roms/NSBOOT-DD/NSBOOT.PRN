

                ;=============================================================
                ; Northstar MDS-D Boot
                ; Disassambled by Martin Eberhard from ROMs found on an MDS-D
                ; 28 November 2016
                ;=============================================================
                ; Assembled code matches MDS-D ROM code exactly when assembled
                ; with Digital Research's ASM.
                ;
                ; This program uses no RAM (and that means no stack).
                ; Subroutines are passed the return address in register pair
                ; hl instead.
                ;
                ; Double-density disks boot from track 0, sector 4. This is a
                ; normal 512-byte double-density sector.
                ;
                ; Single-density disks boot from track 1, sector 8. This is a
                ; special 512-byte single-density sector. (Normal single-
                ; density sectors are 256 bytes long.)
                ;
                ; In either case, the first byte in the sector is the RAM page
                ; address (high address byte) for the boot sector. The
                ; subsequent 511 bytes are loaded into RAM starting at byte 1
                ; of the specified page (xx01). The next byte after these 512
                ; bytes is the CRC of the first 512 bytes.
                ;=============================================================
                
                ;---------
                ;Constants
                ;---------
 000A =         RETRYS	equ	10		;max retries
 0004 =         DDBSCR	equ	4		;Double-density boot sector
 0008 =         SDBSCR	equ	8		;Single-density boot sector
                
                ;-----------------
                ;Memory Allocation
                ;-----------------
 E800 =         CTLBAS	equ	0E800h		;Disk controller base address
 E800 =         ROMADR	equ	CTLBAS		;Standard ROM address
 E900 =         CTLWD	equ	CTLBAS+100h	;Write data
 EA00 =         CTLORD	equ	CTLBAS+200h	;Controller Orders
 EB00 =         CTLCMD	equ	CTLBAS+300h	;Controller Commands
                
                ;-----------------------------
                ;MDS-D Disk Controller Equates
                ;-----------------------------
                
                ;Order Register Bits
                
 0000 =         ORDDS0	equ	00		;No drive selected
 0001 =         ORDDS1	equ	01h		;Select drive 1
 0002 =         ORDDS2	equ	02h		;Select dribe 2
 0004 =         ORDDS3	equ	04h		;Select drive 3
 0008 =         ORDDS4	equ	08h		;Select drive 4
 0010 =         ORDST	equ	10h		;Step level
 0020 =         ORDSIN	equ	20h		;Step in
 0040 =         ORDSS	equ	40h		;Disk side
 0080 =         ORDDD	equ	80h		;Double-density
                
                ;Control register bits
                
 0001 =         CTLRSF	equ	01h		;reset sector flag
 0002 =         CTLDI	equ	02h		;Disarm interrupt
 0003 =         CTLEI	equ	03h		;Arm interrupt
 0004 =         CTLSB	equ	04h		;Set Body (diag)
 0005 =         CTLMO	equ	05h		;Motors on
 0006 =         CTLWR	equ	06h		;Begin write
 0007 =         CTLRES	equ	07h		;REset controller
                
 0010 =         CTLAS	equ	10h		;Select A-Status
 0020 =         CTLBS	equ	20h		;Select B-Status
 0030 =         CTLCS	equ	30h		;Select C-Status
 0040 =         CTLRD	equ	40h		;Select read data
                
                ;A-Status Bits
                
 0001 =         SABD	equ	01h		;sync chr detected (body)
 0004 =         SARE	equ	04h		;Read enabled
 0008 =         SAWI	equ	08h		;Sector window
 0010 =         SAMO	equ	10h		;Motor on
 0020 =         SADD	equ	20h		;Double density detected
 0040 =         SAIX	equ	40h		;Index hole on previous sector
 0080 =         SASF	equ	80h		;Sector flag (cleared by software)
                
                ;B-Status Bits
                
 0001 =         SBT0	equ	01h		;Track 0 detected
 0002 =         SBWP	equ	02h		;Write protected
 0008 =         SBWR	equ	08h		;Write operation in progress
 0010 =         SBMO	equ	10h		;Motor on
 0020 =         SBDD	equ	20h		;Double density detected
 0040 =         SBIX	equ	40h		;Index hole on previous sector
 0080 =         SBSF	equ	80h		;Sector flag (cleared by software)
                
                ;C-Status Bits
                
 000F =         SCSM	equ	0Fh		;Sector mask
 0010 =         SCMO	equ	10h		;Motor on
 0020 =         SCDD	equ	20h		;Double density detected
 0040 =         SCIX	equ	40h		;Index hole on previous sector
 0080 =         SCSF	equ	80h		;Sector flag (cleared by software)
                
                ;==================
                ;Start of Execution
                ;==================
 E800           	org	CTLBAS
                
 E800 0E0A      INIT:	mvi	c,RETRYS		;Initialize retry counter
                
                ;----------------------------------------------------------
                ;Start the spindle motors, select drive 1, and delay enough
                ;time for the motor to spin up and the head to settle
                ;----------------------------------------------------------
 E802 3A15EB    	lda	CTLCMD+CTLAS+CTLMO ;Motor on
                
 E805 1630      	mvi	d,30h		;48 secs: motor spin-up delay
 E807 210DE8    	lxi	h,INITR1	;'return' address
 E80A C3D3E8    	jmp	WSECTD
                INITR1:
                
 E80D 3A01EA    	lda	CTLORD+ORDDS1	;Select drive 1
                
 E810 2116E8    	lxi	h,INITR2	;'return' address
 E813 C34DE8    	jmp	WSECT2		;2 secs: head settling delay
                INITR2:
                
                ;--------------------------------------------------
                ;Wait for the index mark to ensure hard-sector disk
                ;--------------------------------------------------
 E816 060C      	mvi	b,0ch		;wait no more than 12 sectors
                
 E818 211EE8    IWLOOP:	lxi	h,IWLPR1	;'return' address
 E81B C3D1E8    	jmp	WSECT1		;wait for next setor
                IWLPR1:
                
 E81E 3A10EB    	lda	CTLCMD+ORDST	;Get A-Status
 E821 E640      	ani	SAIX		;Index hole?
 E823 C22DE8    	jnz	HOME		;y: carry on
                
 E826 05        	dcr	b		;keep hunting for index
 E827 C218E8    	jnz	IWLOOP		;unless its not there
                
                ;No index hole found after 12 sectors. Hang here forever
                
 E82A C32AE8    HANG1:	jmp	HANG1
                
                ;----------------------------------------------------------------
                ;Home: Seek track 0
                ;(There is no check for track 0 failure. The code will just loop
                ;here, stepping outward forever if the track 0 sensor has failed.
                ;----------------------------------------------------------------
                
                ;Step in once to step away from the track 0 sensor
                
 E82D 3A21EA    HOME:	lda	CTLORD+ORDSIN+ORDDS1		;Step level low, step in
 E830 3A31EA    	lda	CTLORD+ORDSIN+ORDST+ORDDS1	;step level high, step in
 E833 3A21EA    	lda	CTLORD+ORDSIN+ORDDS1
 E836 C34AE8    	jmp	HWAIT
                
                ;Step out until on track 0
                
 E839 3A20EB    HOMER1:	lda	CTLCMD+CTLBS		;Read B-Status
 E83C E601      	ani	SBT0			;On track 0?
 E83E C252E8    	jnz	HUNT			;y: go find the right sector
                
                ;Step out once, and delay (for 2 sector times) while it steps
                
 E841 3A01EA    	lda	CTLORD+ORDDS1		;Step level low, step out
 E844 3A11EA    	lda	CTLORD+ORDST+ORDDS1	;Step level high, step out
 E847 3A01EA    	lda	CTLORD+ORDDS1		;Step level low, step out
                
 E84A 2139E8    HWAIT:	lxi	h,HOMER1		;'return' address
                
                ;Fall into WSECT2
                
                ;***Subroutine***********************
                ;Wait 2 sector times
                ;On Entry:
                ;  hl = return address
                ;On Exit:
                ;  a = 0
                ;  d = 0
                ;  Sector flag is cleared
                ;************************************
 E84D 1602      WSECT2:	mvi	d,2
 E84F C3D3E8    	jmp	WSECTD
                
                ;---------------------------------------------
                ;Hunt: Wait for the double-density boot sector
                ;---------------------------------------------
 E852 2158E8    HUNT:	lxi	h,HUNTR1		;'return' address
 E855 C3D1E8    	jmp	WSECT1			;Wait for next sector
                
 E858 3A35EB    HUNTR1:	lda	CTLCMD+CTLCS+CTLMO	;Read C-Status
 E85B E60F      	ani	SCSM			;Sector mask
 E85D FE04      	cpi	DDBSCR			;Found our boot sector?
 E85F C252E8    	jnz	HUNT			;N: Keep looking
                
                ;Wait for hardware to say that read is enabled
                
 E862 3A10EB    WAITRD:	lda	CTLCMD+CTLAS		;Read A-Status
 E865 E604      	ani	SARE			;Read enabled?
 E867 CA62E8    	jz	WAITRD			;n: wait more
                
                ;Stall for about 68 uS on a 2 MHz 8080
                ;or about 34 uS on a 4 MHz Z80
                
 E86A 3E09      	mvi	a,9
 E86C 3D        STAL68:	dcr	a			;(5)
 E86D C26CE8    	jnz	STAL68			;(10)
                
                ;-----------------------------------------------------------
                ;Check for single-density disk, which gets special treatment
                ;-----------------------------------------------------------
 E870 3A10EB    	lda	CTLCMD+CTLAS		;Read A-Status
 E873 E620      	ani	SADD			;Double-density disk?
 E875 C297E8    	jnz	GETSEC			;y: go read the sector
                
                ;---------------------------------------------
                ;Single-density boot
                ;Step in to track 1 and hunt for sector 8
                ;(Sector 8 is a special 512-byte boot sector.)
                ;---------------------------------------------
 E878 3A21EA    	lda	CTLORD+ORDSIN+ORDDS1		;Step in, step level low
 E87B 3A31EA    	lda	CTLORD+ORDSIN+ORDST+ORDDS1	;step level high, step in
 E87E 3A21EA    	lda	CTLORD+ORDSIN+ORDDS1		;Step in, step level low
                
 E881 2187E8    	lxi	h,SDBR1			;'return' address
 E884 C34DE8    	jmp	WSECT2			;Wait for 2 sector times
                SDBR1:
                
 E887 218DE8    SDRSCT:	lxi	h,SDBR2			;'return' address
 E88A C3D1E8    	jmp	WSECT1			;Wait for 1 sector time
                SDBR2:
                
 E88D 3A35EB    	lda	CTLCMD+CTLCS+CTLMO	;Read C-Status
 E890 E60F      	ani	SCSM			;Sector mask
 E892 FE08      	cpi	SDBSCR			;single-density boot sector
 E894 C287E8    	jnz	SDRSCT
                
                ;Fall into GETSEC
                
                ;----------------------------------------
                ;Wait for the sector body.
                ;Time out after a ridiculously long time.
                ;----------------------------------------
 E897 068C      GETSEC:	mvi	b,8ch			;timeout max (1.2 mS at 4MHz)
 E899 1140EB    	lxi	d,CTLCMD+CTLRD		;Select Read Data
                
 E89C 3A10EB    WATSEC:	lda	CTLCMD+CTLAS		;(7)Read A-Status
 E89F 0F        	rrc				;(4)SABD set? (Sync chr detected)
 E8A0 DAAEE8    	jc	RDDATA			;(10)y: go read data
                
 E8A3 05        	dcr	b			;(5)
 E8A4 C29CE8    	jnz	WATSEC			;(10)
                
                ;Error during load. Retry if we can.
                
 E8A7 0D        ERROR:	dcr	c			;More retries left?
 E8A8 C22DE8    	jnz	HOME			;y: try again
                
                ;------------------------------------------
                ;Can't find sector body. Hang here forever.
                ;------------------------------------------
 E8AB C3ABE8    HANG2:	jmp	HANG2			;Hang forever
                
                ;--------------------------------------------------------------
                ;Read and validate sector data
                ;  Byte 0: <PA> High byte of RAM address
                ;  Bytes 1-511: Sector data
                ;  Byte 512: CRC of Bytes 0-511
                ;Bytes1-511 get written into RAM at <PA>01 through <PA+1>FF.
                ; <PA> gets written to <PA>01 before getting overwritten by
                ; byte 1. <PA>+00 never gets written
                ;--------------------------------------------------------------
 E8AE 1A        RDDATA:	ldax	d			;read 1st disk data byte
 E8AF 67        	mov	h,a			;This is the target RAM page		
 E8B0 2E01      	mvi	l,1			;byte 1 in that page
 E8B2 77        	mov	m,a			;save page address (why?)
                
 E8B3 07        	rlc				;Start CRC calculation
 E8B4 47        	mov	b,a			;b accumulates CRC
                
                ;Read the next 255 bytes (the remainder of the data that goes
                ;into the 1st RAM page) into the specified RAM page
                
 E8B5 1A        RLOOP1:	ldax	d			;get a disk data byte
 E8B6 77        	mov	m,a			;write it to RAM
 E8B7 A8        	xra	b			;compute CRC
 E8B8 07        	rlc
 E8B9 47        	mov	b,a			;..in b
 E8BA 2C        	inr	l			;end of page data?
 E8BB C2B5E8    	jnz	RLOOP1			;n: goet another byte
                
                ;Read the final 256 bytes into the next RAM page
                
 E8BE 24        	inr	h			;Next RAM page
                
 E8BF 1A        RLOOP2:	ldax	d			;get a disk data byte
 E8C0 77        	mov	m,a			;write it to RAM
 E8C1 A8        	xra	b			;compute CRC
 E8C2 07        	rlc
 E8C3 47        	mov	b,a			;..in b
 E8C4 2C        	inr	l			;end of sector data?
 E8C5 C2BFE8    	jnz	RLOOP2			;n: keep reading
                
 E8C8 1A        	ldax	d			;Get CRC byte
 E8C9 A8        	xra	b			;Does it match?
 E8CA C2A7E8    	jnz	ERROR			;n: retry if possible
                
                ;-----------------------------------------
                ;Success. Go execute the loaded code image
                ;-----------------------------------------
 E8CD 25        	dcr	h			;get execution address
 E8CE 2E0A      	mvi	l,0ah			;10th byte of load page
 E8D0 E9        	pchl				;Go execute loaded code
                
                ;***Subroutine***********************
                ;Wait 1 sector time
                ;On Entry:
                ;  hl = return address
                ;On Exit:
                ;  a = 0
                ;  d = 0
                ;  Sector flag is cleared
                ;************************************
 E8D1 1601      WSECT1:	mvi	d,1
                
                ;Fall into WSECTD
                
                ;***Subroutine***********************
                ;Wait d sector times
                ;On Entry:
                ;  d = number of sector tines to wait
                ;  hl = return address
                ;On Exit:
                ;  a = 0
                ;  d = 0
                ;  Sector flag is cleared
                ;************************************
 E8D3 3A11EB    WSECTD:	lda	CTLCMD+CTLAS+CTLRSF;REset sector flag
                
 E8D6 3A10EB    WSECTR:	lda	CTLCMD+CTLAS		;Read A-Status
 E8D9 B7        	ora	a			;Test SASF (Sector flag)
 E8DA F2D6E8    	jp	WSECTR			;Wait for sector
                
 E8DD 15        	dcr	d			;next sector
 E8DE 3A11EB    	lda	CTLCMD+CTLAS+CTLRSF	;Reset sector flag
 E8E1 C2D3E8    	jnz	WSECTD			;more sectors to wait?
                
 E8E4 E9        	pchl				;'return' from subroutine
                
                ;----------------
                ;Unused ROM space
                ;----------------
 E8E5 00        	nop
 E8E6 00        	nop
 E8E7 00        	nop
 E8E8 00        	nop
 E8E9 00        	nop
 E8EA 00        	nop
 E8EB 00        	nop
 E8EC 00        	nop
 E8ED 00        	nop
 E8EE 00        	nop
 E8EF 00        	nop
 E8F0 00        	nop
 E8F1 00        	nop
 E8F2 00        	nop
 E8F3 00        	nop
 E8F4 00        	nop
 E8F5 00        	nop
 E8F6 00        	nop
 E8F7 00        	nop
 E8F8 00        	nop
 E8F9 00        	nop
 E8FA 00        	nop
 E8FB 00        	nop
 E8FC 00        	nop
 E8FD 00        	nop
                
                ;------------
                ;Spare return
                ;------------
 E8FE E1        	pop	h			;spurious 'return'
 E8FF E9        	pchl
                
 E900           	end
